# Copie para .env e preencha. O .env nunca vai pro repositório.
# Variáveis EXPO_PUBLIC_* entram no bundle do app (são públicas por natureza).

# Fase 1: token público do Mapbox (começa com pk.)
EXPO_PUBLIC_MAPBOX_TOKEN=

# Fase 1: token secreto do Mapbox, só se o build Android pedir para baixar o SDK (sk.).
# Usado apenas na compilação, nunca no app.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# Fase 2: Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
