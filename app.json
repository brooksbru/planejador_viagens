{
  "expo": {
    "name": "Planejador de viagens",
    "slug": "planejador-viagens",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "planejadorviagens",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0C2630",
    "android": {
      "package": "com.brooksbru.planejadorviagens",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#0C2630",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.brooksbru.planejadorviagens"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "cmakeVersion": "4.1.2"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/HankenGrotesk-Regular.ttf",
            "./assets/fonts/HankenGrotesk-Medium.ttf",
            "./assets/fonts/HankenGrotesk-SemiBold.ttf",
            "./assets/fonts/Fraunces-SemiBold.ttf",
            "./assets/fonts/Fraunces-Bold.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C2630",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@rnmapbox/maps",
      "./plugins/withCmakePolicyMinimum"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
